# scripts/setup.ps1 creates .env with a random secret.
# If copying manually, set a stable random secret before use.
SECRET_KEY=
DATABASE_URL=sqlite:///artworks.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# MySQL example (create the database and account first):
# DATABASE_URL=mysql+pymysql://art_user:password@127.0.0.1:3306/art_recommend?charset=utf8mb4
